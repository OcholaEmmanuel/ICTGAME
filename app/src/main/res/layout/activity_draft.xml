<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="Time: 20s"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player1ScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/timerText"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:text="Player 1: 0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/player2ScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/timerText"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"
            android:text="Player 2: 0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/turnIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/player1ScoreText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="Player 1's Turn"
            android:textSize="20sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/draftGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/turnIndicator"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:background="#444444"
            android:columnCount="6"
            android:padding="4dp"
            android:rowCount="9" />

        <Button
            android:id="@+id/resetGameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/draftGrid"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Reset Game" />

</RelativeLayout>